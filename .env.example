# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Neon Postgres) — added in Phase 2 ---
# Pooled connection, used by the app at runtime.
DATABASE_URL=""
# Unpooled connection, used only for migrations.
DIRECT_URL=""

# --- Auth.js — added in Phase 2 ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional Google OAuth (app works with email/password alone without these)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI — added in Phase 5 ---
# Google AI Studio (Gemini) — free tier, no billing required.
# Get one at https://aistudio.google.com/apikey
# Server-side only. Never expose to the client / never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=""
